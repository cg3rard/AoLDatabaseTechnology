# Salin file ini menjadi .env lalu ganti nilainya.
# .env TIDAK di-commit (sudah ada di .gitignore).

# MySQL (dipakai docker-compose.yml dan backend)
MYSQL_ROOT_PASSWORD=ganti_root_password
DB_NAME=property_management
DB_USER=admin_user
DB_PASSWORD=ganti_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Backend
APP_PORT=8080

# Login (JWT). JWT_SECRET minimal 32 karakter acak. Contoh membuatnya (PowerShell):
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=ganti_dengan_teks_acak_minimal_32_karakter
JWT_EXPIRE_HOURS=24

# Admin pertama (dibuat otomatis saat backend start jika belum ada admin).
# Setelah admin terbuat, boleh dikosongkan.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti_password_admin_min_8_karakter
